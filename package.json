{
  "name": "@ddlaws0n/agent-stuff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun build ./scripts/validate-skills.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "typecheck:python": "bun run ./scripts/typecheck-python.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:python": "uvx ruff==0.17.3 check --select E9,F63,F7,F82 skills eval/harness scripts",
    "lint:shell": "bun run ./scripts/lint-shell.ts",
    "lint:workflows": "uv run skills/create-github-actions/scripts/validate-workflows.py .github/workflows --require-sha --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "standard:sync": "bun run ./scripts/sync-standard.ts",
    "standard:check": "bun run ./scripts/sync-standard.ts --check",
    "skills:check": "bun run ./scripts/validate-skills.ts",
    "skills:lint": "agnix --strict skills",
    "skills:spec": "for skill in skills/*/; do uvx --from skills-ref==0.1.1 agentskills validate \"$skill\" || exit 1; done",
    "skills:scan": "uvx --from cisco-ai-skill-scanner==2.2.0 skill-scanner scan-all skills --fail-on-severity high",
    "skills:versions": "bun run ./scripts/check-skill-versions.ts",
    "test": "bun test",
    "test:python": "bun run ./scripts/test-skills.ts",
    "test:python:minimum": "bun run ./scripts/test-skills.ts --minimum",
    "test:installed": "bun run ./scripts/test-installed-skills.ts",
    "test:tooling:python": "uv run python -B scripts/run-python-tests.py scripts/installed-skills",
    "test:eval": "uv run python -B scripts/run-python-tests.py eval/harness",
    "check": "bun run typecheck && bun run typecheck:python && bun run lint && bun run lint:python && bun run lint:shell && bun run lint:workflows && bun run format:check && bun run standard:check && bun run skills:check && bun run skills:lint && bun run skills:spec && bun run test && bun run test:python && bun run test:tooling:python && bun run test:eval"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "agnix": "^0.56.4",
    "lefthook": "^2.1.16",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "agnix"
  ]
}
